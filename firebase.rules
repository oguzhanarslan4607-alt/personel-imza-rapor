rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isDayUnlocked(date) {
      return !exists(/databases/$(database)/documents/dayLocks/$(date))
        || get(/databases/$(database)/documents/dayLocks/$(date)).data.locked != true;
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    match /staff/{staffId} {
      allow read, write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isDayUnlocked(request.resource.data.date);
      allow delete: if isAdmin() && isDayUnlocked(resource.data.date);
    }

    match /deletedAttendance/{deletedAttendanceId} {
      allow read, write: if isAdmin();
    }

    match /printArchives/{archiveId} {
      allow read, write: if isAdmin();
    }

    match /dayLocks/{lockId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /settings/{settingsId} {
      allow read, write: if isAdmin();
    }

    match /incapacityReports/{reportId} {
      allow read, write: if isAdmin();
    }

    match /holidayWork/{workId} {
      allow read, write: if isAdmin();
    }

    match /hourlyLeave/{leaveId} {
      allow read, write: if isAdmin();
    }

    match /annualLeave/{leaveId} {
      allow read, write: if isAdmin();
    }
  }
}
